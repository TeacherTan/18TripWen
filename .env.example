# 服务
PORT=3000
NODE_ENV=development

# 数据库（与 docker-compose.yml 保持一致）
DATABASE_URL=postgresql://18trip:18trip_dev@localhost:5432/18trip

# JWT
JWT_SECRET=replace-with-random-64-chars-for-production
JWT_EXPIRES_IN=30d

# 存储（local = 本地磁盘，aliyun = 阿里云 OSS）
STORAGE_PROVIDER=local
UPLOAD_DIR=./server/uploads

# 上传限制
UPLOAD_MAX_SIZE=2097152
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
